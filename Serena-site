<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Serena - Moda Praia & Moda Íntima</title>
  <style>
    body {
      margin: 0;
      font-family: 'Segoe UI', sans-serif;
      background: #ffffff;
      color: #333;
    }
    header {
      background-color: #40e0d0;
      padding: 1rem 2rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    header img {
      height: 60px;
    }
    nav a {
      margin-left: 1rem;
      text-decoration: none;
      color: white;
      font-weight: bold;
    }
    .hero {
      text-align: center;
      padding: 4rem 2rem;
    }
    .hero h1 {
      color: #40e0d0;
      font-size: 2.5rem;
      margin-bottom: 1rem;
    }
    .products {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 2rem;
      padding: 2rem;
    }
    .product {
      border: 1px solid #eee;
      border-radius: 16px;
      padding: 1rem;
      text-align: center;
    }
    .product img {
      max-width: 100%;
      border-radius: 12px;
    }
    .product h2 {
      color: #40e0d0;
    }
    .product button {
      background-color: #40e0d0;
      color: white;
      border: none;
      padding: 0.5rem 1rem;
      border-radius: 8px;
      cursor: pointer;
      margin-top: 0.5rem;
    }
    footer {
      text-align: center;
      padding: 2rem;
      background-color: #f8f8f8;
      color: #777;
      font-size: 0.9rem;
    }
  </style>
</head>
<body>
  <header>
    <img src="/mnt/data/AC2D13EC-ACDF-4203-AEDE-8141893AC15D.jpeg" alt="Logo Serena">
    <nav>
      <a href="#home">Home</a>
      <a href="#produtos">Produtos</a>
    </nav>
  </header>

  <section class="hero" id="home">
    <h1>Bem-vinda à Serena</h1>
    <p>Moda praia & íntima com elegância e conforto</p>
  </section>

  <section class="products" id="produtos">
    <div class="product">
      <img src="https://via.placeholder.com/300x300?text=Biqu%C3%ADni+Vermelho" alt="Biquíni Vermelho">
      <h2>Biquíni Fio Dental</h2>
      <p>R$ 89,90</p>
      <button onclick="comprar('Biquíni Fio Dental')">Comprar</button>
    </div>
    <div class="product">
      <img src="https://via.placeholder.com/300x300?text=Conjunto+Lingerie" alt="Conjunto Lingerie">
      <h2>Conjunto Lingerie</h2>
      <p>R$ 99,90</p>
      <button onclick="comprar('Conjunto Lingerie')">Comprar</button>
    </div>
    <!-- Adicione mais produtos aqui -->
  </section>

  <footer>
    &copy; 2025 Serena. Todos os direitos reservados.
  </footer>

  <script>
    function comprar(produto) {
      window.open(`https://wa.me/SEUNUMERO?text=Quero%20comprar%20o%20${encodeURIComponent(produto)}`);
    }
  </script>
</body>
</html>
